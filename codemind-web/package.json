    "type-check": "vue-tsc --build",
    "test:stream": "node scripts/verify-ai-stream.mjs",
    "test:markdown": "node scripts/verify-markdown.mjs",
    "test:decoding": "node scripts/verify-stream-decoding.mjs",
    "test:layout": "node scripts/verify-layout.mjs",
    "test:render": "node scripts/verify-render.mjs",
    "test:browser": "node scripts/verify-browser.mjs",
    "test:ui": "run-s test:layout test:render test:browser",
    "test": "run-s test:decoding test:stream test:markdown test:layout test:render",
    "shot:home": "node scripts/capture-home.mjs",
    "test:login": "node scripts/verify-login.mjs",
    "test:list": "node scripts/verify-article-list.mjs",
    "test:detail": "node scripts/verify-article-detail.mjs",
    "test:note": "node scripts/verify-note.mjs",
    "shot:list": "node scripts/capture-article-list.mjs",
    "shot:detail": "node scripts/capture-article-detail.mjs",
    "shot:note": "node scripts/capture-note.mjs"
